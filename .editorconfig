# Editor defaults matching .prettierrc and .gitattributes, so editors on
# every OS (notably VS Code on Windows) create files the same way.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[{scripts/screenshots/fixtures/net/**,docs/program/npm_downloads.csv}]
# Recorded byte for byte; see .gitattributes.
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
